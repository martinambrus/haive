{
  "name": "@haive/module-statistics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "import": "./dist/dashboard/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.web.typecheck.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@haive/database": "workspace:*",
    "@haive/shared": "workspace:*",
    "@haive/web-kit": "workspace:*",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.12",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
