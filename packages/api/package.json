{
  "name": "@haive/api",
  "version": "0.1.0",
  "private": true,
  "description": "Hono REST API server for Haive",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:first-admin-race": "tsx test/first-admin-race-smoke.ts",
    "smoke:house-rules-storage": "tsx test/house-rules-storage-smoke.ts",
    "smoke:house-rules-enforcement": "tsx test/house-rules-enforcement-smoke.ts",
    "smoke:reset-provenance": "tsx test/onboarding-reset-provenance-smoke.ts",
    "smoke:step-retry-skip": "tsx test/step-retry-skip-smoke.ts",
    "smoke:task-retry-parked": "tsx test/task-retry-parked-smoke.ts",
    "smoke:multi-user-isolation": "tsx test/multi-user-isolation-smoke.ts",
    "smoke:plan-chat-surfaces": "tsx test/plan-chat-surfaces-smoke.ts",
    "smoke:terminal": "tsx test/terminal-smoke.ts",
    "smoke:step-retry-claim-race": "tsx test/step-retry-claim-race-smoke.ts",
    "smoke:upgrade-single-live": "tsx test/upgrade-single-live-smoke.ts",
    "smoke:all": "pnpm smoke:first-admin-race && pnpm smoke:house-rules-storage && pnpm smoke:house-rules-enforcement && pnpm smoke:reset-provenance && pnpm smoke:step-retry-skip && pnpm smoke:step-retry-claim-race && pnpm smoke:task-retry-parked && pnpm smoke:upgrade-single-live && pnpm smoke:multi-user-isolation && pnpm smoke:plan-chat-surfaces && pnpm smoke:terminal",
    "smoke:ci": "pnpm smoke:first-admin-race && pnpm smoke:house-rules-storage && pnpm smoke:house-rules-enforcement && pnpm smoke:reset-provenance && pnpm smoke:step-retry-skip && pnpm smoke:step-retry-claim-race && pnpm smoke:task-retry-parked && pnpm smoke:upgrade-single-live && pnpm smoke:multi-user-isolation && pnpm smoke:plan-chat-surfaces",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@haive/database": "workspace:*",
    "@haive/shared": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.11",
    "dockerode": "^5.0.1",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.12",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/dockerode": "^4.0.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
