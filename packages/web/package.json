{
  "name": "@haive/web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js Conductor-style web UI for Haive",
  "scripts": {
    "dev": "node ../../scripts/gen-modules.mjs && next dev -p 3000",
    "build": "node ../../scripts/gen-modules.mjs && next build",
    "start": "next start -p 3000",
    "typecheck": "node ../../scripts/gen-modules.mjs && tsc --noEmit",
    "test": "node ../../scripts/gen-modules.mjs && vitest run --passWithNoTests",
    "clean": "rm -rf .next dist *.tsbuildinfo"
  },
  "dependencies": {
    "@haive/module-statistics": "workspace:*",
    "@haive/shared": "workspace:*",
    "@haive/web-kit": "workspace:*",
    "@novnc/novnc": "^1.5.0",
    "@tiptap/core": "^3.35.1",
    "@tiptap/extension-list": "^3.35.1",
    "@tiptap/extension-table": "^3.35.1",
    "@tiptap/extensions": "^3.35.1",
    "@tiptap/pm": "^3.35.1",
    "@tiptap/react": "^3.35.1",
    "@tiptap/starter-kit": "^3.35.1",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.9.3",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^1.83.0",
    "mermaid": "^11.17.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.1",
    "tiptap-markdown": "^0.9.0",
    "tldts": "^7.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.34",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.3",
    "vitest": "^5.1.2"
  }
}
