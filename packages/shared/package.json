{
  "name": "@haive/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, schemas, crypto, and utilities for Haive",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js"
    },
    "./attachments": {
      "types": "./dist/attachments/index.d.ts",
      "import": "./dist/attachments/index.js"
    },
    "./rag": {
      "types": "./dist/rag/index.d.ts",
      "import": "./dist/rag/index.js"
    },
    "./review": {
      "types": "./dist/review/index.d.ts",
      "import": "./dist/review/index.js"
    },
    "./global-kb": {
      "types": "./dist/global-kb/index.d.ts",
      "import": "./dist/global-kb/index.js"
    },
    "./plan": {
      "types": "./dist/plan/index.d.ts",
      "import": "./dist/plan/index.js"
    },
    "./timing": {
      "types": "./dist/step-engine/timing.d.ts",
      "import": "./dist/step-engine/timing.js"
    },
    "./scope-tree": {
      "types": "./dist/repo/scope-tree.d.ts",
      "import": "./dist/repo/scope-tree.js"
    },
    "./knowledge-paths": {
      "types": "./dist/knowledge-paths.d.ts",
      "import": "./dist/knowledge-paths.js"
    },
    "./claude-oauth": {
      "types": "./dist/cli-providers/claude-oauth.d.ts",
      "import": "./dist/cli-providers/claude-oauth.js"
    },
    "./fair-priority": {
      "types": "./dist/scheduling/fair-priority.d.ts",
      "import": "./dist/scheduling/fair-priority.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@haive/database": "workspace:*",
    "drizzle-orm": "0.45.2",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
