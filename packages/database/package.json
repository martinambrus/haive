{
  "name": "@haive/database",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schemas and migrations for Haive",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "push": "drizzle-kit push",
    "baseline:generate": "node scripts/generate-baseline.mjs",
    "migrate": "node dist/migrate/index.js",
    "migrate:tsx": "tsx src/migrate/index.ts",
    "smoke:migrate": "tsx test/migrate-smoke.ts",
    "studio": "drizzle-kit studio",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
